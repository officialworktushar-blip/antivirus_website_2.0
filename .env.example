# Optional: set a support phone before showing the click-to-call action.
# Use an international format; leave empty to show the contact form instead.
VITE_SUPPORT_PHONE=

# Configure only the official remote-support destination. It opens after a user click.
VITE_ANYDESK_SUPPORT_URL=

# Optional: POST endpoint for submitted support requests. Without this, requests remain local.
VITE_SUPPORT_REQUEST_URL=

# Server-only values: configure these in the API host, never in VITE_ variables.
SENTRIQ_ADMIN_EMAIL=
SENTRIQ_ADMIN_PASSWORD_HASH=
SENTRIQ_DATA_DIR=
